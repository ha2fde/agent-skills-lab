# Copy to .env and fill these locally. Never commit your .env.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_DATA_DIR=./data
# Optional: enable relative image_path values inside this directory only.
# WECHAT_IMAGE_ROOT=./images

# Required only for HTTP mode. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MCP_BEARER_TOKEN=
HOST=127.0.0.1
PORT=8787
# Exact Host header values, comma separated. Default: localhost/127.0.0.1/[::1]:PORT.
# MCP_ALLOWED_HOSTS=localhost:8787,127.0.0.1:8787
# Browser Origin requests are rejected unless explicitly allowed here.
# MCP_ALLOWED_ORIGINS=https://your-mcp-client.example
