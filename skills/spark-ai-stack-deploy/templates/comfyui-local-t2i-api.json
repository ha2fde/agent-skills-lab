{
  "_comment": "C 引擎（ComfyUI v0.39.2）本地/离线 Qwen-Image-2.1 文生图工作流（API 格式）。用法：curl -X POST http://<spark>:8188/prompt -H 'Content-Type: application/json' -d @this.json。实测纯内网/断网 ~46s 出 1024^2 PNG。关键：CLIPLoader 用 qwen3vl_8b_int8_convrot（图像编码器），NOT pe_t2i（那是提示词增强 LLM）；latent 用 EmptyLatentImage。",
  "prompt": {
    "3": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
        "weight_dtype": "default"
      }
    },
    "4": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
        "type": "qwen_image"
      }
    },
    "5": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
      }
    },
    "11": {
      "class_type": "QwenImage21Cache",
      "inputs": {
        "model": ["3", 0],
        "device": "auto",
        "dtype": "default"
      }
    },
    "6": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 1024,
        "height": 1024,
        "batch_size": 1
      }
    },
    "7": {
      "class_type": "TextEncodeQwenImage21",
      "inputs": {
        "clip": ["4", 0],
        "prompt": "a serene mountain landscape at sunrise, soft oil painting style, warm golden light, high detail",
        "negative_prompt": "",
        "resolution": 1024,
        "images": []
      }
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["11", 0],
        "seed": 0,
        "steps": 25,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "positive": ["7", 0],
        "negative": ["7", 1],
        "latent_image": ["6", 0],
        "denoise": 1.0
      }
    },
    "9": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["8", 0],
        "vae": ["5", 0]
      }
    },
    "10": {
      "class_type": "SaveImage",
      "inputs": {
        "images": ["9", 0],
        "filename_prefix": "qwen21_local"
      }
    }
  },
  "client_id": "spark-local-t2i"
}
